{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@skyscanner/backpack-react-scripts": "^11.2.4",
    "@skyscanner/backpack-web": "^15.1.0",
    "bpk-mixins": "^36.1.1",
    "bpk-stylesheets": "^7.2.16",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "sass": "^1.85.0",
    "sass-embedded": "^1.105.1"
  },
  "backpack-react-scripts": {
    "cssModules": false,
    "babelIncludePrefixes": [
      "./node_modules/@skyscanner/backpack-web/bpk-component-calendar",
      "./node_modules/@skyscanner/backpack-web/bpk-react-utils",
      "./node_modules/@skyscanner/backpack-web/bpk-component-icon",
      "./node_modules/@skyscanner/backpack-web/bpk-component-select",
      "./node_modules/@skyscanner/backpack-web/bpk-component-aria-live"
    ]
  },
  "overrides": {
    "node-sass": "npm:sass@^1.85.0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
