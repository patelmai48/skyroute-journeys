PORT=5000
# Long random string (at least 16 chars). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin(s), comma separated. Add your Vercel URL after deploying.
CORS_ORIGIN=http://localhost:3000
# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/skyroute?sslmode=disable
NODE_ENV=development
