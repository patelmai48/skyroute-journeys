# SkyRoute Environment Configuration Example
# Copy this file to .env or .env.local to configure OAuth and app settings

# Real Google OAuth Client ID (from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Server configuration
PORT=3000
GENERATE_SOURCEMAP=false
